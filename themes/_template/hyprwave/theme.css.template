/* HyprWave theme — generated by HyprAesthetic from theme.toml palette */

:root {
    --bg-primary: {{hw_bg_primary}};
    --bg-secondary: {{hw_bg_secondary}};
    --bg-album-cover: {{hw_bg_album}};
    --bg-album-secondary: {{hw_bg_album_secondary}};
    --btn-default: {{hw_btn_default}};
    --btn-default-secondary: {{hw_btn_default_secondary}};
    --btn-default-hover: {{hw_btn_default_hover}};
    --btn-default-hover-secondary: {{hw_btn_default_hover_secondary}};
    --btn-play: {{hw_btn_play}};
    --btn-play-secondary: {{hw_btn_play_secondary}};
    --btn-play-hover: {{hw_btn_play_hover}};
    --btn-play-hover-secondary: {{hw_btn_play_hover_secondary}};
    --btn-play-active: {{hw_btn_play_active}};
    --btn-play-active-secondary: {{hw_btn_play_active_secondary}};
    --btn-expand: {{hw_btn_expand}};
    --btn-expand-secondary: {{hw_btn_expand_secondary}};
    --btn-expand-hover: {{hw_btn_expand_hover}};
    --btn-expand-hover-secondary: {{hw_btn_expand_hover_secondary}};
    --btn-expand-active: {{hw_btn_expand_active}};
    --btn-expand-active-secondary: {{hw_btn_expand_active_secondary}};
    --progress-bg: {{hw_progress_bg}};
    --progress-fill-start: {{hw_progress_fill_start}};
    --progress-fill-end: {{hw_progress_fill_end}};
    --handle-color: {{hw_handle_color}};
    --handle-hover: {{hw_handle_hover}};
    --handle-border: {{hw_handle_border}};
    --handle-shadow: {{hw_handle_shadow}};
    --text-primary: {{hw_text_primary}};
    --text-secondary: {{hw_text_secondary}};
    --text-tertiary: {{hw_text_tertiary}};
    --text-muted: {{hw_text_muted}};
    --border-primary: {{hw_border_primary}};
    --border-button: {{hw_border_button}};
    --border-button-hover: {{hw_border_button_hover}};
    --border-play: {{hw_border_play}};
    --border-play-hover: {{hw_border_play_hover}};
    --border-expand: {{hw_border_expand}};
    --border-expand-hover: {{hw_border_expand_hover}};
    --shadow-default: {{hw_shadow_default}};
    --shadow-button: {{hw_shadow_button}};
    --shadow-play: {{hw_shadow_play}};
    --shadow-play-hover: {{hw_shadow_play_hover}};
    --shadow-expand: {{hw_shadow_expand}};
    --shadow-expand-hover: {{hw_shadow_expand_hover}};
    --shadow-focus: {{hw_shadow_focus}};
    --border-radius-container: 100px;
    --border-radius-section: 20px;
    --border-radius-album: 16px;
    --border-radius-button: 50%;
    --border-radius-progress: 2px;
    --padding-container: 12px;
    --padding-section: 16px;
}

.visualizer-bar {
    background: linear-gradient(180deg, {{hw_viz_top}}, {{hw_viz_bottom}});
    border-radius: 0px;
    transition: all 0.05s ease-out;
    margin: 0px;
    min-width: 1px;
    min-height: 3px;
    box-shadow: 0 0 12px {{hw_viz_glow}}, 0 0 6px {{hw_viz_glow_soft}};
}

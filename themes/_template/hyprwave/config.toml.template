# Hyprwave config template - rendered from theme.toml

[general]
fps = 60
width = 1920
height = 1080

[visualizer]
enabled = true
type = "wave"
bars = 64
sensitivity = 1.0
color_scheme = "theme"

[colors]
background = "{{colors.base00}}"
foreground = "{{colors.base05}}"
primary = "{{colors.base0D}}"
secondary = "{{colors.base0E}}"
accent = "{{colors.base0C}}"
error = "{{colors.base08}}"
warning = "{{colors.base0A}}"
success = "{{colors.base0B}}"

[wave]
style = "filled"
thickness = 2
gap = 1
mirror = true
round_caps = true

[particles]
enabled = false
count = 100
size = 2
speed = 0.5

[audio]
source = "auto"
fallback = "monitor"
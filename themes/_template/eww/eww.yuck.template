;; Eww config template - rendered from theme.toml
;; This is a base template; themes can provide complete overrides

(defvar bar-height 30)

(defvar colors
  (list
    :background "{{colors.base00}}"
    :foreground "{{colors.base05}}"
    :primary "{{colors.base0D}}"
    :secondary "{{colors.base0E}}"
    :accent "{{colors.base0C}}"
    :error "{{colors.base08}}"
    :warning "{{colors.base0A}}"
    :success "{{colors.base0B}}"
    :surface "{{colors.base01}}"
    :surface-hover "{{colors.base02}}"
    :border "{{colors.base03}}"
    :foreground-muted "{{colors.base04}}"
  )
)

;; Bar widget
(defwidget bar []
  (box :class "bar" :orientation "h" :space-evenly false :halign "fill"
    ;; Left: workspaces
    (box :class "bar-left" :orientation "h" :spacing 4
      (workspaces :class "workspaces" :orientation "h" :spacing 2)
    )
    
    ;; Center: window title
    (box :class "bar-center" :orientation "h" :halign "center" :valign "center"
      (window-title :class "window-title" :max-length 50)
    )
    
    ;; Right: system modules
    (box :class "bar-right" :orientation "h" :spacing 4 :halign "end"
      (cpu :class "cpu")
      (memory :class "memory")
      (temperature :class "temperature")
      (network :class "network")
      (audio :class "audio")
      (battery :class "battery")
      (clock :class "clock")
      (tray :class "tray")
    )
  )
)

;; Workspaces widget
(defwidget workspaces []
  (box :class "workspaces" :orientation "h" :spacing 2
    (for i (range 1 11)
      (button :class (if (eq i (hyprland-active-workspace)) "workspace active" "workspace")
        :onclick (hyprland-dispatch-workspace i)
        (label :text (to-string i))
      )
    )
  )
)

;; Window title
(defwidget window-title []
  (label :class "window-title" :text (hyprland-active-window-title))
)

;; System widgets
(defwidget cpu []
  (box :class "cpu" :orientation "h" :spacing 4
    (label :text "")
    (label :text (cpu-usage))
  )
)

(defwidget memory []
  (box :class "memory" :orientation "h" :spacing 4
    (label :text "")
    (label :text (memory-usage))
  )
)

(defwidget temperature []
  (box :class "temperature" :orientation "h" :spacing 4
    (label :text "")
    (label :text (thermal-temperature))
  )
)

(defwidget network []
  (box :class "network" :orientation "h" :spacing 4
    (label :text (if (network-wifi-connected) "" ""))
    (label :text (network-ssid))
  )
)

(defwidget audio []
  (box :class "audio" :orientation "h" :spacing 4
    (label :text (audio-icon))
    (label :text (audio-volume))
    :onclick (run "pavucontrol")
  )
)

(defwidget battery []
  (box :class "battery" :orientation "h" :spacing 4
    (label :text (battery-icon))
    (label :text (battery-percent))
  )
)

(defwidget clock []
  (box :class "clock" :orientation "h" :spacing 4
    (label :text (date "%H:%M"))
    :onclick (run "calendar")
  )
)

(defwidget tray []
  (systray :class "tray")
)
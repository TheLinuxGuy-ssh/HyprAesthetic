// Eww SCSS - rendered from theme.toml ([colors.eww])

$background: {{colors.eww.background}};
$foreground: {{colors.eww.foreground}};
$surface: {{colors.eww.surface}};
$surface-hover: {{colors.eww.surface_hover}};
$border: {{colors.eww.border}};
$foreground-muted: {{colors.eww.foreground_muted}};
$primary: {{colors.eww.primary}};
$primary-fg: {{colors.eww.primary_fg}};
$error: {{colors.eww.error}};
$error-fg: {{colors.eww.error_fg}};
$warning: {{colors.eww.warning}};
$warning-fg: {{colors.eww.warning_fg}};
$success: {{colors.eww.success}};
$success-fg: {{colors.eww.success_fg}};
$matrix-color: {{colors.eww.matrix_color}};
$font-ui: "{{identity.font_ui}}";
$font-clock: "{{identity.font_clock}}";
$font-mono: "{{identity.font_mono}}";
$font-quote: "{{identity.font_quote}}";
$clock-size: {{identity.clock_size}}px;
$music-radius: {{identity.music_radius}}px;
$cover-size: {{identity.cover_size}}px;

/** Global *******************************************/
.matrix-container {
  min-width: 24px;
}

.card {
  background-color: transparent;
  border: none;
  padding: 0;
}

.matrix-lbl {
  color: $matrix-color;
  font-size: {{identity.matrix_size}}px;
  font-weight: 500;
  opacity: {{identity.matrix_opacity}};
  font-family: $font-mono;
}

.waka-container {}

.waka-text {
  color: $foreground-muted;
  font-size: 14px;
  font-weight: 700;
  opacity: 1;
  font-family: "Iosevka";
  border-radius: 0.25em;
}

.toji-container {}

.toji-text {
  color: $foreground-muted;
  font-size: 16px;
  font-style: italic;
  font-family: $font-quote;
}

* {
  all: unset;
  font-family: $font-ui;
}

window {
  background-color: transparent;
}

/** Background ***************************************/
.bg {
  background-image: url("images/bg.png");
  background-color: $surface;
  opacity: 1;
}

/** Generic window ***********************************/
.genwin {
  background-color: transparent;
  border: none;
  border-radius: 16px;
}

.panel {
  background-color: transparent;
  border: none;
  padding: 0;
}

.genwin.panel {
  background-color: transparent;
  border: none;
  padding: 0;
}

/** Profile ******************************************/
.face {
  background-size: 200px;
  min-height: 200px;
  min-width: 200px;
  margin: 65px 0px 0px 0px;
  border-radius: 100%;
}

.fullname {
  color: $primary;
  font-size: 30px;
  font-weight: bold;
}

.username {
  color: $success;
  font-size: 22px;
  font-weight: bold;
  margin: -15px 0px 0px 0px;
}

/** System ********************************************/
.iconcpu, .iconmem, .iconbright, .iconbat, .icondisk {
  font-size: 32px;
  font-weight: normal;
  all: unset;
  font-family: "Iosevka Nerd Font";
}
.iconcpu {
  color: $foreground-muted;
}
.iconmem {
  color: $foreground-muted;
}
.icondisk {
  color: $foreground-muted;
}
.iconbright {
  color: $warning;
}
.iconbat {
  color: $primary;
}

.cpu_bar, .mem_bar, .bright_bar, .bat_bar, .disk_bar, scale trough {
  all: unset;
  background-color: $border;
  border-radius: 2px;
  min-height: 2px;
  min-width: 140px;
}

.cpu_bar, .mem_bar, .bright_bar, .bat_bar, .disk_bar, scale trough highlight {
  all: unset;
  border-radius: 16px;
}

.cpu_bar scale trough highlight {
  background-color: $primary;
}
.mem_bar scale trough highlight {
  background-color: $primary;
}
.disk_bar scale trough highlight {
  background-color: $primary;
}
.bright_bar scale trough highlight {
  background-color: $warning;
}
.bat_bar scale trough highlight {
  background-color: $primary;
}

/** Clock ********************************************/
.time_hour, .time_min {
  color: $foreground;
  font-size: $clock-size;
  font-weight: bold;
  font-family: $font-clock;
}
.time_hour {
  margin: 15px 0px 0px 20px;
}
.time_min {
  margin: 0px 0px 10px 0px;
}

.time_mer {
  color: $primary;
  font-size: 40px;
  font-weight: bold;
  margin: 20px 0px 0px 0px;
}

.time_day {
  color: $foreground-muted;
  font-size: 30px;
  font-weight: normal;
  margin: 20px 0px 20px -20px;
}

/** Uptime ********************************************/
.icontimer {
  color: $primary;
  font-size: 90px;
  font-weight: normal;
}

.uphour {
  color: $foreground;
  font-size: 42px;
  font-weight: bold;
}

.upmin {
  color: $foreground;
  font-size: 32px;
  font-weight: bold;
}

/** Music ***************************************/
.music-card {
  border-radius: $music-radius;
}

.album_art {
  background-size: cover;
  background-position: center;
  min-height: $cover-size;
  min-width: $cover-size;
  margin: 0;
  border-radius: $music-radius;
}

.song {
  color: $primary;
  font-size: 14px;
  font-weight: bold;
  margin: 0;
}

.artist {
  color: $foreground-muted;
  font-size: 12px;
  font-weight: normal;
  margin: 0;
}

.btn_prev, .btn_play, .btn_next {
  font-family: $font-mono;
  font-size: 12px;
  font-weight: bold;
  color: $foreground;
}
.btn_play {
  color: $primary;
}

.music_bar scale trough highlight {
  all: unset;
  background-color: $primary;
  border-radius: 2px;
}
.music_bar scale trough {
  all: unset;
  background-color: $surface-hover;
  border-radius: 2px;
  min-height: 4px;
  min-width: 220px;
  margin: 0;
}

/** Weather ***************************************/
.iconweather {
  font-family: "Iosevka Nerd Font";
  font-size: 120px;
  font-weight: normal;
  margin: 15px 0px 0px 30px;
}

.label_temp {
  color: $foreground;
  font-size: 80px;
  font-weight: bold;
  margin: -15px 30px 0px 0px;
}

.label_stat {
  color: $error;
  font-size: 38px;
  font-weight: bold;
}

.label_quote {
  color: $foreground-muted;
  font-size: 18px;
  font-weight: normal;
}

/** Applications ***************************************/
.appbox {
  margin: 15px 0px 0px 25px;
}

.app_fox, .app_telegram, .app_discord, .app_terminal,
.app_files, .app_geany, .app_code, .app_gimp, .app_vbox {
    background-repeat: no-repeat;
  background-size: 64px;
  min-height: 64px;
  min-width: 64px;
  margin: 8px 8px 0px 8px;
}

/** Links ***************************************/
.iconweb, .iconmail {
  color: $foreground;
  font-family: "Iosevka Nerd Font";
  font-size: 70px;
  font-weight: normal;
}
.iconmail {
  color: $error;
}

/* Brand colors - literal by design, these are service identities */
.github {
  background-color: #24292E;
  border-radius: 16px;
}
.reddit {
  background-color: #E46231;
  border-radius: 16px;
}
.twitter {
  background-color: #61AAD6;
  border-radius: 16px;
}
.youtube {
  background-color: #DF584E;
  border-radius: 16px;
}

.mail {
  background-color: $foreground;
  border-radius: 16px;
}

.mailbox {
  background-color: $foreground;
  border-radius: 10px;
  margin: 48px 0px 48px 0px;
}
.label_mails {
  color: $background;
  font-size: 32px;
  font-weight: bold;
  margin: 0px 12px 0px 12px;
}

/** Power buttons ***************************************/
.btn_logout, .btn_sleep, .btn_reboot, .btn_poweroff {
  font-size: 48px;
  font-weight: bold;
}

.btn_logout {
  color: $error;
}
.btn_sleep {
  color: $success;
}
.btn_reboot {
  color: $warning;
}
.btn_poweroff {
  color: $primary;
}

/** Home folders ***************************************/
.hddbox {
  background-color: $surface-hover;
  border-radius: 10px;
  margin: 15px;
}
.hddicon {
  color: $primary;
  font-family: "Iosevka Nerd Font";
  font-size: 70px;
  font-weight: normal;
  margin: 25px 20px 25px 40px;
}
.hdd_label {
  color: $foreground;
  font-size: 48px;
  font-weight: bold;
  margin: 0px 0px 0px 15px;
}
.fs_sep {
  color: $border;
  font-size: 36px;
  font-weight: bold;
}

.iconfolder1, .iconfolder2, .iconfolder3, .iconfolder4, .iconfolder5, .iconfolder6  {
  font-family: "Iosevka Nerd Font";
  font-size: 32px;
  font-weight: normal;
  margin: 0px 0px 0px 75px;
}
.iconfolder1 {
  color: $error;
}
.iconfolder2 {
  color: $success;
}
.iconfolder3 {
  color: $warning;
}
.iconfolder4 {
  color: $primary;
}
.iconfolder5 {
  color: $foreground-muted;
}
.iconfolder6 {
  color: $foreground-muted;
}

.label_folder1, .label_folder2, .label_folder3, .label_folder4, .label_folder5, .label_folder6  {
  font-size: 22px;
  font-weight: normal;
  margin: 0px 0px 0px 30px;
}
.label_folder1 {
  color: $error;
}
.label_folder2 {
  color: $success;
}
.label_folder3 {
  color: $warning;
}
.label_folder4 {
  color: $primary;
}
.label_folder5 {
  color: $foreground-muted;
}
.label_folder6 {
  color: $foreground-muted;
}

/** EOF *************************************************/

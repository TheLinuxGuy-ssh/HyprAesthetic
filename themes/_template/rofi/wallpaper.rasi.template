/*****----- HyprAesthetic Wallpaper / Theme Picker -----*****/
configuration {
    modi:        "dmenu";
    show-icons:  true;
}

* {
    background:       {{colors.waybar.background}};
    background-alt:   {{colors.waybar.surface}};
    foreground:       {{colors.waybar.foreground}};
    foreground-muted: {{colors.waybar.foreground_muted}};
    selected:         {{colors.waybar.border}};
    active:           {{colors.waybar.surface_hover}};
    urgent:           {{colors.waybar.error}};
    on-surface:       {{colors.waybar.foreground}};
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            450px;
    height:           330px;
    border:           0px solid;
    border-radius:    0px;
    border-color:     @selected;
    background-color: @background;
}

mainbox {
    spacing:          20px;
    padding:          10px;
    border:           1px solid;
    border-radius:    20px;
    border-color:     @selected;
    background-color: @background;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    spacing:          20px;
    background-color: @background;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
}

prompt {
    padding:          15px;
    border-radius:    15px;
    background-color: @active;
    text-color:       @foreground;
}

textbox-prompt-colon {
    expand:           false;
    str:              "::";
    background-color: inherit;
    text-color:       inherit;
}

entry {
    width:            200px;
    padding:          15px 10px;
    border-radius:    15px;
    background-color: @background-alt;
    text-color:       @foreground;
    placeholder:      "Search...";
    placeholder-color: @foreground-muted;
}

listview {
    columns:          2;
    lines:            2;
    cycle:            true;
    dynamic:          true;
    fixed-height:     true;
    fixed-columns:    true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          0px;
    background-color: transparent;
    text-color:       @foreground;
}

element {
    spacing:          0;
    padding:          10px;
    border:           0px solid;
    border-radius:    20px;
    background-color: @background;
    text-color:       @foreground;
    orientation:      vertical;
}

element normal.normal {
    background-color: @background;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @background-alt;
    text-color:       @foreground;
}

element-icon {
    size:             200px;
    background-color: transparent;
    text-color:       @foreground;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color:       @foreground;
}

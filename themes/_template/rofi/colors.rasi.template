/**
 * Rofi colors - rendered from theme.toml ([colors.waybar])
 * Structural chrome uses border/surface tokens; primary is accent only.
 */

* {
    background:     {{colors.waybar.background}};
    background-alt: {{colors.waybar.surface}};
    foreground:     {{colors.waybar.foreground}};
    foreground-muted: {{colors.waybar.foreground_muted}};
    selected:       {{colors.waybar.surface_hover}};
    active:         {{colors.waybar.primary}};
    urgent:         {{colors.waybar.error}};
    theme-border:   {{colors.waybar.border}};
    primary-fg:     {{colors.waybar.primary_fg}};
    on-surface:     {{colors.waybar.foreground}};
    on-primary:     {{colors.waybar.primary_fg}};
}
